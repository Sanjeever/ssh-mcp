{
  "name": "@sanjeever/ssh-mcp",
  "version": "0.1.1",
  "description": "通过 stdio MCP 管理多台 SSH 服务器，执行命令并传输文件",
  "license": "MIT",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Sanjeever/ssh-mcp.git"
  },
  "homepage": "https://github.com/Sanjeever/ssh-mcp#readme",
  "bugs": "https://github.com/Sanjeever/ssh-mcp/issues",
  "bin": {
    "ssh-mcp": "bin/ssh-mcp.cjs"
  },
  "files": [
    "bin/ssh-mcp.cjs",
    "LICENSE",
    "README.md"
  ],
  "engines": {
    "node": ">=22"
  },
  "publishConfig": {
    "access": "public"
  },
  "packageManager": "pnpm@11.20.0",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build:ts": "tsc",
    "test:ts": "pnpm build:ts && node --test test/*.test.mjs",
    "test": "node --test bin/ssh-mcp.test.cjs scripts/version.test.mjs scripts/release.test.mjs",
    "metadata": "node scripts/build.mjs metadata",
    "build": "node scripts/build.mjs build",
    "pack:check": "node scripts/pack-check.mjs",
    "bump": "node scripts/version.mjs bump",
    "version:check": "node scripts/version.mjs check"
  },
  "optionalDependencies": {
    "@sanjeever/ssh-mcp-darwin-arm64": "0.1.1",
    "@sanjeever/ssh-mcp-darwin-x64": "0.1.1",
    "@sanjeever/ssh-mcp-linux-arm64": "0.1.1",
    "@sanjeever/ssh-mcp-linux-x64": "0.1.1",
    "@sanjeever/ssh-mcp-win32-arm64": "0.1.1",
    "@sanjeever/ssh-mcp-win32-x64": "0.1.1"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.1",
    "ssh2": "1.17.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "@types/ssh2": "1.15.6",
    "typescript": "7.0.2"
  }
}
