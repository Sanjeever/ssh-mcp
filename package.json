{
  "name": "@sanjeever/ssh-mcp",
  "version": "0.4.1",
  "description": "通过 stdio MCP 管理多台 SSH 服务器，执行命令并传输文件",
  "license": "MIT",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Sanjeever/ssh-mcp.git"
  },
  "homepage": "https://github.com/Sanjeever/ssh-mcp#readme",
  "bugs": "https://github.com/Sanjeever/ssh-mcp/issues",
  "bin": {
    "ssh-mcp": "dist/cli.js"
  },
  "files": [
    "dist/cli.js",
    "dist/THIRD_PARTY_NOTICES.txt",
    "LICENSE",
    "README.md"
  ],
  "engines": {
    "node": ">=22"
  },
  "publishConfig": {
    "access": "public"
  },
  "packageManager": "pnpm@11.20.0",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "node --import=tsx --test test/*.test.ts scripts/*.test.ts",
    "build": "node --import=tsx scripts/build.ts",
    "pack:check": "node --import=tsx scripts/pack-check.ts",
    "bump": "node --import=tsx scripts/version.ts bump",
    "version:check": "node --import=tsx scripts/version.ts check"
  },
  "devDependencies": {
    "@modelcontextprotocol/sdk": "1.32.1",
    "@types/node": "22.20.5",
    "@types/ssh2": "1.15.6",
    "esbuild": "0.28.2",
    "ssh2": "1.17.0",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "zod": "4.6.7"
  }
}
